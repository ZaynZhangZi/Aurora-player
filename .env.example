# Copy this file to .env.local and point the proxies at your own services.
# VITE_* values are public browser configuration. Do not put private keys here.

# Music API: /api is stripped by the Vite development proxy.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
VITE_API_TIMEOUT=10000

# Custom content backend: /backend-api is stripped by the development proxy.
VITE_ADMIN_API_BASE_URL=/backend-api
VITE_ADMIN_API_PROXY_TARGET=http://127.0.0.1:8080
VITE_ADMIN_API_TIMEOUT=10000

# Optional development/debug features.
VITE_ENABLE_VUE_DEVTOOLS=false
VITE_AUTOMIX_DEBUG=false
